{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trin://schemas/ConfluenciaReplayV1",
  "title": "ConfluenciaReplayV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_schema",
    "id_confluencia",
    "timestamp_calculo",
    "origem_tipo",
    "status",
    "modo",
    "garantia_fiscal",
    "criterios_consulta",
    "universo",
    "particao_dados",
    "quantidade_experiencias",
    "ids_experiencias",
    "evidencias",
    "classificacoes_evidencia",
    "concordancias",
    "divergencias",
    "estatisticas_mfe",
    "estatisticas_mae",
    "metricas_qualidade_hipotese",
    "resultados_por_horario",
    "resultados_por_volatilidade",
    "resultados_por_contexto",
    "confianca_diagnostica",
    "peso",
    "impacto_operacional",
    "bloqueios",
    "motivos",
    "rastreabilidade",
    "hash_resultado"
  ],
  "properties": {
    "versao_schema": {
      "const": "1.0.0"
    },
    "id_confluencia": {
      "type": "string",
      "pattern": "^CFR-[0-9A-F]{32}$"
    },
    "timestamp_calculo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Timestamp semântico determinístico: máximo timestamp_referencia incluído; null sem evidências."
    },
    "origem_tipo": {
      "const": "ORIGEM_REPLAY"
    },
    "status": {
      "enum": [
        "COMPLETO",
        "PARCIAL",
        "SEM_EVIDENCIA",
        "INSUFICIENTE",
        "BLOQUEADO"
      ]
    },
    "modo": {
      "const": "SOMBRA"
    },
    "garantia_fiscal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelo",
        "fronteira_homologada",
        "certificado_individual_exigido_na_confluencia",
        "campos_rastreabilidade_exigidos"
      ],
      "properties": {
        "modelo": {
          "const": "HERDADA_DO_INGRESSO_HISTORIADOR_HOMOLOGADO"
        },
        "fronteira_homologada": {
          "const": "RepositorioExperiencias"
        },
        "certificado_individual_exigido_na_confluencia": {
          "const": false
        },
        "campos_rastreabilidade_exigidos": {
          "const": [
            "solicitacao_id",
            "origem_id",
            "origem_hash"
          ]
        }
      }
    },
    "criterios_consulta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "trin://schemas/ConsultaConfluenciaReplayV1",
      "title": "ConsultaConfluenciaReplayV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrato_consulta",
        "versao",
        "modo_analise",
        "origem_id",
        "perfil_criterio",
        "campos_comparacao",
        "contexto_alvo",
        "particao_dados",
        "politica_universo"
      ],
      "properties": {
        "contrato_consulta": {
          "const": "ConsultaConfluenciaReplayV1"
        },
        "versao": {
          "const": "1.0.0"
        },
        "modo_analise": {
          "const": "RETROSPECTIVO_SELADO"
        },
        "origem_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Único filtro repassado à API homologada. null consulta o universo completo."
        },
        "perfil_criterio": {
          "const": "CRITERIO_CONFLUENCIA_REPLAY_V1"
        },
        "campos_comparacao": {
          "type": "array",
          "prefixItems": [
            {
              "const": "fato.evento.ativo"
            },
            {
              "const": "contexto.regime"
            },
            {
              "const": "contexto.sessao.sessao_id"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "contexto_alvo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ativo",
            "regime",
            "sessao_id"
          ],
          "properties": {
            "ativo": {
              "type": "string",
              "minLength": 1
            },
            "regime": {
              "type": "string",
              "minLength": 1
            },
            "sessao_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "particao_dados": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metodo",
            "percentual_calibracao",
            "percentual_prova"
          ],
          "properties": {
            "metodo": {
              "const": "CORTE_TEMPORAL_50_50_V1_PROVISORIO"
            },
            "percentual_calibracao": {
              "const": 50
            },
            "percentual_prova": {
              "const": 50
            }
          }
        },
        "politica_universo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usar_universo_completo",
            "top_n",
            "limite_seguranca",
            "ordem",
            "filtro_direcao"
          ],
          "properties": {
            "usar_universo_completo": {
              "const": true
            },
            "top_n": {
              "type": "null"
            },
            "limite_seguranca": {
              "const": 1000
            },
            "ordem": {
              "const": "timestamp_referencia_ordinal_referencia_experiencia_id_ASC"
            },
            "filtro_direcao": {
              "type": "null"
            }
          }
        }
      }
    },
    "universo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantidade_total_retornada",
        "ids_universo_ordenados",
        "hash_universo",
        "ids_incluidos",
        "excluidos",
        "regra_top_n",
        "filtros_permitidos",
        "filtros_proibidos"
      ],
      "properties": {
        "quantidade_total_retornada": {
          "type": "integer",
          "minimum": 0
        },
        "ids_universo_ordenados": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hash_universo": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ids_incluidos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "excluidos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "experiencia_id",
              "motivo"
            ],
            "properties": {
              "experiencia_id": {
                "type": "string"
              },
              "motivo": {
                "enum": [
                  "SCHEMA_INVALIDO",
                  "ORIGEM_INVALIDA",
                  "RASTREABILIDADE_INCOMPLETA",
                  "DUPLICIDADE_EXATA",
                  "DUPLICIDADE_CONFLITANTE",
                  "UNIVERSO_ACIMA_LIMITE_SEGURANCA"
                ]
              }
            }
          }
        },
        "regra_top_n": {
          "const": "DESABILITADO_USAR_UNIVERSO_COMPLETO"
        },
        "filtros_permitidos": {
          "const": [
            "origem_id"
          ]
        },
        "filtros_proibidos": {
          "const": [
            "direcao",
            "resultado",
            "mfe_pontos",
            "mae_pontos",
            "desfecho",
            "ids_escolhidos_manualmente"
          ]
        }
      }
    },
    "particao_dados": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metodo",
        "provisorio",
        "ids_calibracao",
        "ids_prova",
        "hash_particao",
        "intersecao"
      ],
      "properties": {
        "metodo": {
          "const": "CORTE_TEMPORAL_50_50_V1_PROVISORIO"
        },
        "provisorio": {
          "const": true
        },
        "ids_calibracao": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ids_prova": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hash_particao": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "intersecao": {
          "maxItems": 0,
          "type": "array"
        }
      }
    },
    "quantidade_experiencias": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "ids_experiencias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 1000
    },
    "evidencias": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiencia_id",
          "experiencia_sha256",
          "origem_tipo",
          "origem_id",
          "origem_hash",
          "timestamp_referencia",
          "ordinal_referencia",
          "classificacao_evidencia",
          "criterios",
          "direcao",
          "mfe_pontos",
          "mae_pontos",
          "particao"
        ],
        "properties": {
          "experiencia_id": {
            "type": "string",
            "minLength": 1
          },
          "experiencia_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origem_tipo": {
            "const": "ORIGEM_REPLAY"
          },
          "origem_id": {
            "type": "string",
            "minLength": 1
          },
          "origem_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "timestamp_referencia": {
            "type": "string",
            "format": "date-time"
          },
          "ordinal_referencia": {
            "type": "integer",
            "minimum": 1
          },
          "classificacao_evidencia": {
            "enum": [
              "NEUTRA",
              "FAVORAVEL",
              "CONTRARIA",
              "BLOQUEADORA"
            ]
          },
          "criterios": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "campo",
                "resultado",
                "valor_alvo",
                "valor_experiencia"
              ],
              "properties": {
                "campo": {
                  "enum": [
                    "fato.evento.ativo",
                    "contexto.regime",
                    "contexto.sessao.sessao_id"
                  ]
                },
                "resultado": {
                  "enum": [
                    "CONCORDA",
                    "DIVERGE",
                    "NAO_AVALIADO"
                  ]
                },
                "valor_alvo": {},
                "valor_experiencia": {},
                "motivo_nao_avaliado": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "minItems": 3,
            "maxItems": 3
          },
          "direcao": {
            "enum": [
              "COMPRA",
              "VENDA",
              null
            ]
          },
          "mfe_pontos": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "mae_pontos": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "particao": {
            "enum": [
              "CALIBRACAO",
              "PROVA"
            ]
          },
          "motivos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "maxItems": 1000
    },
    "classificacoes_evidencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "NEUTRA",
        "FAVORAVEL",
        "CONTRARIA",
        "BLOQUEADORA"
      ],
      "properties": {
        "NEUTRA": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantidade",
            "ids"
          ],
          "properties": {
            "quantidade": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "maxItems": 1000
            }
          }
        },
        "FAVORAVEL": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantidade",
            "ids"
          ],
          "properties": {
            "quantidade": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "maxItems": 1000
            }
          }
        },
        "CONTRARIA": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantidade",
            "ids"
          ],
          "properties": {
            "quantidade": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "maxItems": 1000
            }
          }
        },
        "BLOQUEADORA": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantidade",
            "ids"
          ],
          "properties": {
            "quantidade": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "maxItems": 1000
            }
          }
        }
      }
    },
    "concordancias": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiencia_id",
          "campo",
